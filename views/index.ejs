<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Dynamic SEO -->
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <link rel="canonical" href="<%= canonical %>" />
    <meta name="msvalidate.01" content="BF20ECE42276F8194BCBE62567F305C3" />

    <!-- Open Graph (social previews) -->
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:url" content="<%= canonical %>" />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://accesspackagebuilder.dev/images/apb-logo.png"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
    <meta
      name="twitter:image"
      content="https://accesspackagebuilder.dev/images/apb-logo.png"
    />
    <!-- SEO Keywords -->
    <meta name="keywords" content="Access Packages, Entra Access Packages, Microsoft Entra ID, Identity Governance, Entra Identity Governance, Access Package Builder, Microsoft Entra Access Packages, Azure AD Access Packages, Entitlement Management, Identity Lifecycle Management" />
    <meta name="author" content="Nico Wyss" />
    <meta name="robots" content="index, follow" />
    
    <!-- Schema.org SoftwareApplication -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Access Package Builder for Microsoft Entra",
        "alternateName": ["Entra Access Package Builder", "Access Package Tool"],
        "url": "https://accesspackagebuilder.dev",
        "image": "https://accesspackagebuilder.dev/images/apb-logo.png",
        "author": {
          "@type": "Person",
          "name": "Nico Wyss",
          "url": "https://www.linkedin.com/in/nico-wyss/"
        },
        "applicationCategory": "BusinessApplication",
        "applicationSubCategory": "Identity Governance",
        "operatingSystem": "Web Browser",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Free open-source tool to build and automate Microsoft Entra ID Access Packages for Identity Governance. Visualize user group memberships and create Access Packages with PowerShell automation.",
        "featureList": [
          "Access Package visualization",
          "Microsoft Entra ID integration",
          "PowerShell deployment scripts",
          "User group analysis",
          "Identity Governance automation"
        ]
      }
    </script>
    
    <!-- Schema.org FAQPage for rich snippets -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What are Access Packages in Microsoft Entra ID?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Access Packages in Microsoft Entra ID (formerly Azure AD) are bundles of resources that users can request access to. They are part of Entitlement Management and help organizations automate access governance by grouping applications, groups, and SharePoint sites together."
            }
          },
          {
            "@type": "Question",
            "name": "How does Access Package Builder help with Entra Identity Governance?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Access Package Builder analyzes your Microsoft Entra ID users and groups, then automatically suggests Access Packages based on department structures and group memberships. It generates PowerShell scripts to deploy these packages, saving hours of manual configuration."
            }
          },
          {
            "@type": "Question",
            "name": "Is Access Package Builder free to use?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, Access Package Builder is completely free and open-source. It requires read-only permissions (User.Read.All, Directory.Read.All, Group.Read.All) to analyze your tenant."
            }
          },
          {
            "@type": "Question",
            "name": "What permissions does Access Package Builder need?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Access Package Builder requires User.Read.All, Directory.Read.All, and Group.Read.All permissions. These are read-only permissions that allow the tool to analyze users and groups without making any changes to your tenant."
            }
          }
        ]
      }
    </script>

    <!-- Favicon and fonts -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/stylesheets/landing.css" />
  </head>

  <body>
    <div>
      <header class="header">
        <div class="header-content">
          <a href="https://accesspackagebuilder.dev" class="logo">
            <img src="/images/apb-logo.png" alt="Access Package Builder Logo" />
          </a>

          <!-- Mobile Menu Toggle -->
          <button class="menu-toggle" aria-label="Toggle Menu">☰</button>

          <!-- Nav wrapper -->
          <nav class="nav-links">
            <div class="docs-login">
              <a href="/docs" class="docs-btn">Docs</a>
              <a href="/auth/login" class="login-btn">Log In</a>
              <a href="/readiness" class="login-btn">Readiness Check</a>
            </div>
            <div class="social-icons">
              <a
                href="https://www.linkedin.com/in/nico-wyss/"
                target="_blank"
                class="social-icon"
              >
                <i class="fab fa-linkedin-in"></i>
              </a>
              <a
                href="https://github.com/nicowyss/accesspackagebuilder"
                target="_blank"
                class="social-icon"
              >
                <i class="fab fa-github"></i>
              </a>
              <a href="https://cloudfil.ch/blog/" class="social-icon">
                <i class="fas fa-blog"></i>
              </a>
            </div>
          </nav>
        </div>
      </header>

      <!-- Title Section -->
      <section class="hero-section" data-aos="fade-up">
        <div class="hero-container">
          <!-- Left: Title and Subtitle -->
          <div class="hero-text">
            <h1 class="big-title">
              <span class="sr-only">Microsoft Entra</span> Access Package <span class="wobble">B</span>uilder
            </h1>
            <h2 class="subtitle">
              The free open-source tool for Microsoft Entra ID Identity Governance. 
              Build Access Packages automatically with smart visualization and PowerShell automation.
            </h2>
            <a href="/auth/login" class="try-btn">Try it Free</a>
            <div class="tech-stack">
              <div class="tech-item">
                <i class="fa-brands fa-github"></i>
                <p>Open Source</p>
              </div>
              <div class="tech-item">
                <i class="fas fa-terminal"></i>
                <p>PowerShell</p>
              </div>
              <div class="tech-item">
                <i class="fa-brands fa-node-js"></i>
                <p>Node.js</p>
              </div>
              <div class="tech-item">
                <i class="fas fa-book"></i>
                <p>Docsify</p>
              </div>
              <div class="tech-item">
                <i class="fa-brands fa-square-js"></i>
                <p>JavaScript</p>
              </div>
              <div class="tech-item">
                <i class="fas fa-cloud"></i>
                <p>Microsoft Cloud</p>
              </div>
            </div>
          </div>

          <!-- Right: Image or Animation -->
          <div class="hero-image">
            <img
              src="/images/landingpicture.png"
              alt="Microsoft Entra Access Package Builder Dashboard - Visualize Identity Governance"
            />
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="features-section" data-aos="fade-up">
        <h2 class="features-title">Entra Access Package Features</h2>
        <p class="features-subtitle">
          Access Package Builder simplifies Microsoft Entra ID Identity Governance and Entitlement Management <br />
          with visual tools, PowerShell integration, and best practices for Access Packages.
        </p>
        <p class="features-subtitle">
          Want to learn more? Check out the <a href="/docs">Docs.</a>
        </p>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-users"></i></div>
            <h3 class="feature-title">Simplified Access</h3>
            <p class="feature-text">
              Effortlessly visualize user group memberships.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-network-wired"></i></div>
            <h3 class="feature-title">Dynamic Visuals</h3>
            <p class="feature-text">
              Explore maps of users, departments, and companies.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-robot"></i></div>
            <h3 class="feature-title">Smart Suggestions</h3>
            <p class="feature-text">
              Get automated Access Package recommendations tailored to your
              data.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-search"></i></div>
            <h3 class="feature-title">Clear Insights</h3>
            <p class="feature-text">
              Identify unassigned groups and optimize your governance.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-filter"></i></div>
            <h3 class="feature-title">Custom Filters</h3>
            <p class="feature-text">
              Focus on specific departments, companies, or users easily.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-thumbs-up"></i></div>
            <h3 class="feature-title">Data Quality</h3>
            <p class="feature-text">
              Identify gaps of not maintained user attributes.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-truck"></i></div>
            <h3 class="feature-title">Deployment</h3>
            <p class="feature-text">
              Show a easy way to deploy your Access Package in Microsoft Entra
              ID with PowerShell.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-link"></i></div>
            <h3 class="feature-title">Seamless Integration</h3>
            <p class="feature-text">
              Built for a smooth Microsoft Entra ID Governance experience.
            </p>
          </div>
        </div>
      </section>
      <!-- Walkthrough / Demo Section -->
      <section class="demo-section" data-aos="fade-up">
        <div class="demo-container">
          <div class="demo-text">
            <h2 class="demo-title">Walkthrough</h2>
            <p class="demo-description">
              Experience how easy it is to visualize your tailored Access
              Packages with just a few clicks. Watch the quick walkthrough to
              see the smart automation and clear insights in action.
            </p>
            <a href="/auth/login" class="try-btn demo-btn">Get Started</a>
          </div>
          <div class="demo-video">
            <video controls loop muted playsinline preload="metadata">
              <source
                src="/images/accesspackagebuilder-video.mp4"
                type="video/mp4"
              />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </section>

      <!-- Footer Section -->
      <footer class="site-footer">
        <div class="footer-container">
          <div class="footer-logo">
            <img src="/images/apb-logo.png" alt="Access Package Builder Logo" />
          </div>
          <div class="footer-links">
            <a href="https://cloudfil.ch/about" target="_blank">About</a>
            <a href="/docs">Docs</a>
            <a
              href="https://github.com/nicowyss/accesspackagebuilder"
              target="_blank"
              >GitHub</a
            >
          </div>
          <div class="footer-copy">
            2025 | Made with ❤️ by
            <a href="https://www.linkedin.com/in/nico-wyss/" target="_blank"
              >Nico Wyss</a
            >
            | Open-source Project | © MIT License
          </div>
        </div>
      </footer>
    </div>
    <script
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="nicowyss"
      data-description="Support me on Buy me a coffee!"
      data-color="#347DFE"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>
    <!-- AOS Animate on Scroll JS -->
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
      AOS.init({
        duration: 800,
        easing: "ease-in-out",
        once: true, // Animates only once
      });
    </script>
